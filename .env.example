# Copy to `.env` and edit. Every setting of `panoptes.data.settings.SurveySettings`
# can be set here; a real environment variable overrides the file.

# What `panoptes-pipeline` produced: `observation.json` per sequence and
# `metadata.json` per frame, in a tree that mirrors the archive layout, so that
# <root>/PAN012/358d0f/20180824T035917/observation.json is a sequence document.
# All metadata is read from here.
PANOPTES_PROCESSED_ROOT=/data/panoptes-processed

# Where `frames.parquet`, `observations.parquet` and `schema.json` live.
# Defaults to the processed tree, which is where the pipeline builds them. Set
# it only if you keep the index somewhere else -- it is regenerable, so there is
# no harm in building it beside a read-only or mirrored processed tree.
# PANOPTES_INDEX_ROOT=/data/panoptes-index

# A local copy of the *raw* archive: the directory holding the unit folders, so
# that <root>/PAN012/358d0f/20180824T035917/20180824T040118.fits.fz is a frame.
# This is a different tree from the processed one. Without it, frames resolve to
# archive URLs, which are not fetchable.
PANOPTES_ARCHIVE_ROOT=/data/panoptes-archive

# The cloud archive as it was laid out. Rarely worth changing; nothing serves
# these objects anonymously any more.
# PANOPTES_IMG_BASE_URL=https://storage.googleapis.com
# PANOPTES_IMG_BUCKET=panoptes-images-incoming
