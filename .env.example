# Copy to `.env` and edit. Every setting of `panoptes.data.settings.SurveySettings`
# can be set here; a real environment variable overrides the file.

# A local copy of the archive: the directory holding the unit folders, so that
# <root>/PAN012/358d0f/20180824T035917/20180824T040118.fits.fz is a frame.
# Without this, frames resolve to archive URLs, which are not fetchable.
PANOPTES_ARCHIVE_ROOT=/data/panoptes-archive

# The cloud archive as it was laid out. Rarely worth changing; nothing serves
# these objects anonymously any more.
# PANOPTES_IMG_BASE_URL=https://storage.googleapis.com
# PANOPTES_IMG_BUCKET=panoptes-images-incoming
# PANOPTES_IMG_METADATA_URL=https://us-central1-project-panoptes-01.cloudfunctions.net/get-observation-info
# PANOPTES_OBSERVATIONS_URL=https://storage.googleapis.com/panoptes-assets/observations.csv
